{% set main_navigation = sulu_navigation_root_tree('main', null, false, -1) %}
{% set contact_snippet = sulu_snippet_load_by_area('footer_contact')|default([]) %}

<!DOCTYPE html>
<html lang="{{ app.request.locale|split('_')[0] }}">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        {% block meta %}
            {{ include('@SuluWebsite/Extension/seo.html.twig', {
                seo: extension.seo|default([]),
                content: content|default([]),
                localizations: localizations|default([]),
                shadowBaseLocale: shadowBaseLocale|default(),
            }) }}
        {% endblock %}

        {% block style %}
            <link rel="stylesheet" href="/css/global.css">
            <link rel="stylesheet" href="/css/navbar.css">
            <link rel="stylesheet" href="/css/button.css">
            <link rel="stylesheet" href="/css/footer.css">
        {% endblock %}
    </head>

    <body>
        <header class="header-navbar">
            {% block header %}
                {% import 'macros/navigation.html.twig' as navigation %}

                <div class="navbar-container">
                    <div class="navbar-logo">
                        <img src="/img/logos/logo-etendu-noir-fond-blanc-wide.png" alt="Logo" class="logo">
                    </div>

                    <nav class="navbar-nav">
                        <ul>
                            <li>
                                <a href="{{ sulu_content_root_path() }}" title="Accueil">Accueil</a>
                            </li>
                            
                            {{ navigation.render_menu_items(main_navigation) }}
                        </ul>
                    </nav>

                    <div class="navbar-action">
                        <a class="btn-primary" href="#" title="Demander un devis">Demander un devis</a>
                    </div>
                </div>
            {% endblock %}
        </header>

        <main>
            {% block content %}{% endblock %}
        </main>

        <footer>
            {% block footer %}
                <div class="footer-grid">
                    <div class="footer-column">
                        <h3>Navigation</h3>
                        <ul class="footer-links">
                            <li><a href="{{ sulu_content_root_path() }}" title="Accueil">Accueil</a></li>
                            {% for item in main_navigation %}
                                {% if item.title != 'Accueil' %}
                                    <li>
                                        <a href="{{ sulu_content_path(item.url, item.webspaceKey) }}" title="{{ item.title }}">{{ item.title }}</a>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>

                    <div class="footer-column">
                        <h3>Services</h3>
                        <ul class="footer-links">
                            {% for service in sulu_services() %}
                                <li><a href="{{ service.resourceSegment }}" title="{{ service.title }}">{{ service.title }}</a></li>
                            {% else %}
                                <li><a href="/services">Voir tous mes services</a></li>
                            {% endfor %}
                        </ul>
                    </div>

                    <div class="footer-column">
                        <h3>Contact</h3>
                        <ul class="footer-links footer-contact">
                            {% if contact_snippet.content.show_email|default(true) and contact_snippet.content.email|default('') %}
                                <li><a href="mailto:{{ contact_snippet.content.email }}">{{ contact_snippet.content.email }}</a></li>
                            {% endif %}

                            {% if contact_snippet.content.show_phone|default(true) and contact_snippet.content.phone|default('') %}
                                <li><a href="tel:{{ contact_snippet.content.phone }}">{{ contact_snippet.content.phone }}</a></li>
                            {% endif %}

                            {% if contact_snippet.content.show_address|default(true) and contact_snippet.content.address|default('') %}
                                <li>{{ contact_snippet.content.address|nl2br }}</li>
                            {% endif %}

                            {% set has_social_links = false %}
                            {% if contact_snippet.content.show_linkedin|default(true) and contact_snippet.content.linkedin|default('') %}
                                {% set has_social_links = true %}
                            {% endif %}
                            {% if contact_snippet.content.show_instagram|default(true) and contact_snippet.content.instagram|default('') %}
                                {% set has_social_links = true %}
                            {% endif %}
                            {% if contact_snippet.content.show_facebook|default(true) and contact_snippet.content.facebook|default('') %}
                                {% set has_social_links = true %}
                            {% endif %}
                            {% if contact_snippet.content.show_github|default(true) and contact_snippet.content.github|default('') %}
                                {% set has_social_links = true %}
                            {% endif %}

                            {% if has_social_links %}
                                <li class="footer-social-links">
                                    {% if contact_snippet.content.show_linkedin|default(true) and contact_snippet.content.linkedin|default('') %}
                                        <a href="{{ contact_snippet.content.linkedin }}" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn">
                                            <img src="/img/icons/linkedin.svg" alt="" aria-hidden="true">
                                        </a>
                                    {% endif %}

                                    {% if contact_snippet.content.show_instagram|default(true) and contact_snippet.content.instagram|default('') %}
                                        <a href="{{ contact_snippet.content.instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram">
                                            <img src="/img/icons/instagram.svg" alt="" aria-hidden="true">
                                        </a>
                                    {% endif %}

                                    {% if contact_snippet.content.show_facebook|default(true) and contact_snippet.content.facebook|default('') %}
                                        <a href="{{ contact_snippet.content.facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook" title="Facebook">
                                            <img src="/img/icons/facebook.svg" alt="" aria-hidden="true">
                                        </a>
                                    {% endif %}

                                    {% if contact_snippet.content.show_github|default(true) and contact_snippet.content.github|default('') %}
                                        <a href="{{ contact_snippet.content.github }}" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
                                            <img src="/img/icons/github.svg" alt="" aria-hidden="true">
                                        </a>
                                    {% endif %}
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>

                <div class="footer-bottom">
                    <a href="/mentions-legales" title="Mentions légales">Mentions légales</a>
                    <p>© 2026 Lemasson Solutions, EI LEMASSON Louis — Tous droits réservés.</p>
                </div>
            {% endblock %}
        </footer>

        {% block javascripts %}{% endblock %}
    </body>
</html>
