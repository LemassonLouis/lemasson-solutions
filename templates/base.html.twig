{% set main_navigation = sulu_navigation_root_tree('main', null, false, -1) %}

<!DOCTYPE html>
<html lang="{{ app.request.locale|split('_')[0] }}">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        {% block meta %}
            {{ include('@SuluWebsite/Extension/seo.html.twig', {
                seo: extension.seo|default([]),
                content: content|default([]),
                localizations: localizations|default([]),
                shadowBaseLocale: shadowBaseLocale|default(),
            }) }}
        {% endblock %}

        {% block style %}
            <link rel="stylesheet" href="/css/global.css">
            <link rel="stylesheet" href="/css/navbar.css">
            <link rel="stylesheet" href="/css/button.css">
            <link rel="stylesheet" href="/css/footer.css">
        {% endblock %}
    </head>

    <body>
        <header class="header-navbar">
            {% block header %}
                {% import 'macros/navigation.html.twig' as navigation %}

                <div class="navbar-container">
                    <div class="navbar-logo">
                        <img src="/img/logos/logo-etendu-noir-fond-blanc-wide.png" alt="Logo" class="logo">
                    </div>

                    <nav class="navbar-nav">
                        <ul>
                            <li>
                                <a href="{{ sulu_content_root_path() }}" title="Accueil">Accueil</a>
                            </li>
                            
                            {{ navigation.render_menu_items(main_navigation) }}
                        </ul>
                    </nav>

                    <div class="navbar-action">
                        <a class="btn-primary" href="#" title="Demander un devis">Demander un devis</a>
                    </div>
                </div>
            {% endblock %}
        </header>

        <main>
            {% block content %}{% endblock %}
        </main>

        <footer>
            {% block footer %}
                <div class="footer-grid">
                    <div class="footer-column">
                        <h3>Navigation</h3>
                        <ul class="footer-links">
                            <li><a href="{{ sulu_content_root_path() }}" title="Accueil">Accueil</a></li>
                            {% for item in main_navigation %}
                                {% if item.title != 'Accueil' %}
                                    <li>
                                        <a href="{{ sulu_content_path(item.url, item.webspaceKey) }}" title="{{ item.title }}">{{ item.title }}</a>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>

                    <div class="footer-column">
                        <h3>Services</h3>
                        <ul class="footer-links">
                            {% for service in sulu_services() %}
                                <li><a href="{{ service.resourceSegment }}" title="{{ service.title }}">{{ service.title }}</a></li>
                            {% else %}
                                <li><a href="/services">Voir tous mes services</a></li>
                            {% endfor %}
                        </ul>
                    </div>

                    <div class="footer-column">
                        <h3>Contact</h3>
                        <ul class="footer-links footer-contact">
                            <li><a href="mailto:louis.lemasson@lemasson-solutions.fr">louis.lemasson@lemasson-solutions.fr</a></li>
                            <li><a href="tel:+33626420447">06.26.42.04.47</a></li>
                            <li>20 rue Docteur Roux<br>14000 Caen</li>
                            <li><a href="https://www.linkedin.com/company/106228038/admin/dashboard/" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
                            <li><a href="https://www.instagram.com/lemassonsolutions/" target="_blank" rel="noopener noreferrer">Instagram</a></li>
                            <li><a href="https://www.linkedin.com/company/106228038/admin/dashboard/" target="_blank" rel="noopener noreferrer">Facebook</a></li>
                            <li><a href="https://github.com/LemassonLouis" target="_blank" rel="noopener noreferrer">GitHub</a></li>
                        </ul>
                    </div>
                </div>

                <div class="footer-bottom">
                    <a href="/mentions-legales" title="Mentions légales">Mentions légales</a>
                    <p>© 2026 Lemasson Solutions, EI LEMASSON Louis — Tous droits réservés.</p>
                </div>
            {% endblock %}
        </footer>

        {% block javascripts %}{% endblock %}
    </body>
</html>
