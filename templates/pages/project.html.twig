{% extends 'base.html.twig' %}

{% block content %}
    {% if content.heroImage|default('') is empty %}
        <h1>{{ content.title }}</h1>
    {% endif %}

    {% for item in sulu_breadcrumb(uuid) %}
        <a href="{{ sulu_content_path(item.url) }}">{{ item.title }}</a>
    {% endfor %}

    {{ content.context|raw }}

    {{ content.problem|raw }}

    {{ content.solution|raw }}

{% endblock %}
