{% extends 'base.html.twig' %}

{% block content %}
    {% if content.heroImage|default('') is empty %}
        <h1>{{ content.title }}</h1>
    {% endif %}

    {% include 'pages/fragments/_hero.html.twig' %}

    {% for item in sulu_breadcrumb(uuid) %}
        <a href="{{ sulu_content_path(item.url) }}">{{ item.title }}</a>
    {% endfor %}

    {{ content.content|raw }}
{% endblock %}
