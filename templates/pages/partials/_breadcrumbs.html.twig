{% block style %}
    <link rel="stylesheet" href="{{ asset('/css/breadcrumbs.css') }}">
{% endblock %}

<div class="breadcrumbs">
    {% for item in sulu_breadcrumb(uuid) %}
        <a href="{{ sulu_content_path(item.url) }}" title="{{ item.title }}">{{ item.title }}</a>
        {% if not loop.last %}
            <span class="breadcrumb-separator">/</span>
        {% endif %}
    {% endfor %}
</div>