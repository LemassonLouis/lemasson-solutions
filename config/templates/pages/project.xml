<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>project</key>

    <view>pages/project</view>
    <controller>Sulu\Bundle\WebsiteBundle\Controller\DefaultController::indexAction</controller>
    <cacheLifetime>604800</cacheLifetime>

    <meta>
        <title lang="en">Projet</title>
    </meta>

    <properties>
        <property name="title" type="text_line" mandatory="true">
            <meta>
                <title lang="fr">Titre</title>
            </meta>
            <params>
                <param name="headline" value="true"/>
            </params>

            <tag name="sulu.rlp.part"/>
        </property>

        <property name="url" type="resource_locator" mandatory="true">
            <meta>
                <title lang="fr">URL</title>
            </meta>

            <tag name="sulu.rlp"/>
        </property>

        <property name="image" type="single_media_selection"/>

        <property name="projectType" type="single_select">
            <params>
                <param name="values" type="collection">
                    <param name="sitevitrine" />
                    <param name="ecommerce" />
                    <param name="application" />
                </param>
            </params>
        </property>

        <property name="context" type="text_editor">
            <meta>
                <title lang="fr">Contexte</title>
            </meta>
        </property>

        <property name="problem" type="text_editor">
            <meta>
                <title lang="fr">Problème</title>
            </meta>
        </property>

        <property name="solution" type="text_editor">
            <meta>
                <title lang="fr">Solution</title>
            </meta>
        </property>
    </properties>
</template>
