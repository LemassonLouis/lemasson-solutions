<?xml version="1.0" ?>
<section name="hero"
         xmlns="http://schemas.sulu.io/template/template"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <meta>
        <title lang="fr">Bandeau Hero</title>
    </meta>

    <properties>
        <property name="heroImage" type="single_media_selection">
            <meta>
                <title lang="fr">Image</title>
            </meta>

            <params>
                <param name="types" value="image"/>
            </params>
        </property>

        <property name="heroTitle" type="text_line">
            <meta>
                <title lang="fr">Titre</title>
            </meta>
        </property>

        <property name="heroText" type="text_area">
            <meta>
                <title lang="fr">Texte</title>
            </meta>
        </property>

        <property name="hasPrimaryCTA" type="checkbox" colspan="4">
            <params>
                <param name="type" value="toggler"/>
                <param name="label">
                    <meta>
                        <title lang="fr">Afficher le CTA principal</title>
                    </meta>
                </param>
            </params>
        </property>

        <property name="primaryCTA" type="link" visibleCondition="hasPrimaryCTA == true" colspan="8">
            <meta>
                <title lang="fr">URL et libellé du CTA principal</title>
            </meta>

            <params>
                <param name="enable_attributes" value="true"/>
                <param name="types" type="collection">
                    <param name="page"/>
                </param>
            </params>
        </property>

        <property name="hasSecondaryCTA" type="checkbox" visibleCondition="hasPrimaryCTA == true" colspan="4">
            <params>
                <param name="type" value="toggler"/>
                <param name="label">
                    <meta>
                        <title lang="fr">Afficher le CTA secondaire</title>
                    </meta>
                </param>
            </params>
        </property>

        <property name="secondaryCTA" type="link" visibleCondition="hasSecondaryCTA == true" colspan="8">
            <meta>
                <title lang="fr">URL et libellé du CTA secondaire</title>
            </meta>

            <params>
                <param name="enable_attributes" value="true"/>
                <param name="types" type="collection">
                    <param name="page"/>
                </param>
            </params>
        </property>
    </properties>
</section>
