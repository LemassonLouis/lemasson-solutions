<?xml version="1.0" ?>
<section name="faq"
         xmlns="http://schemas.sulu.io/template/template"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <meta>
        <title lang="fr">Foire aux questions</title>
    </meta>

    <properties>
        <property name="faq_title" type="text_line" mandatory="true">
            <meta>
                <title lang="fr">Titre</title>
            </meta>
        </property>

        <block name="faq_items" default-type="item" minOccurs="1">
            <meta>
                <title lang="fr">Questions / Réponses</title>
            </meta>

            <types>
                <type name="item">
                    <properties>
                        <property name="question" type="text_line">
                            <meta>
                                <title lang="fr">Question</title>
                            </meta>
                        </property>

                        <property name="answer" type="text_editor">
                            <meta>
                                <title lang="fr">Réponse</title>
                            </meta>
                        </property>
                    </properties>
                </type>
            </types>
        </block>
    </properties>
</section>
